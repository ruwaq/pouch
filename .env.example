# ═══════════════════════════════════════════════════════════════
# Pouch — Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# NEVER commit .env. This file (.env.example) is safe to commit.
# All values are validated by Zod at startup — app crashes if required vars are missing.
# ═══════════════════════════════════════════════════════════════

# ── Runtime ─────────────────────────────────────────────────────
NODE_ENV=development
# Set to 'true' to force demo mode even in production (e.g. on Vercel).
# Demo mode uses simulated balances/payments — no DB or provider keys needed.
DEMO_MODE=
APP_URL=http://localhost:3000

# ── Blockchain (config-driven, NOT hardcoded in code) ───────────
# Settlement chain = where transactions finalize (Arbitrum One = 42161)
SETTLEMENT_CHAIN_ID=42161
# Comma-separated list of supported chains (Arbitrum, Base, Polygon)
SUPPORTED_CHAINS=42161,8453,137

# ── Off-ramp providers ──────────────────────────────────────────
# Comma-separated list of ACTIVE providers (only those with keys will load)
OFFRAMP_PROVIDERS=bitrefill

# Bitrefill (primary off-ramp: gift cards, top-ups, eSIM)
# Get key: bitrefill.com → Account → Developers
BITREFILL_API_KEY=
BITREFILL_BASE_URL=https://api.bitrefill.com/v2

# Reloadly — CUT from scope (not a direct bounty; smart routing demonstrated
# within Bitrefill product comparison). Adapter remains in code for future use.
# RELOADLY_CLIENT_ID=
# RELOADLY_CLIENT_SECRET=
# RELOADLY_TOPUPS_BASE_URL=https://topups.reloadly.com
# RELOADLY_GIFTCARDS_BASE_URL=https://giftcards.reloadly.com
# RELOADLY_ESIMS_BASE_URL=https://esims.reloadly.com
# RELOADLY_AUTH_URL=https://auth.reloadly.com/oauth/token

# ── Web3 account provider mode ───────────────────────────────────
# development: keep `demo` until Particle/Magic wiring is ready
# production: set to `particle` once real chain abstraction is integrated
WEB3_PROVIDER_MODE=demo
DEMO_USER_BALANCE_USD=150

# ── Wallets ─────────────────────────────────────────────────────

# Magic Labs (embedded wallet, blind signatures, EIP-7702 sign)
# Get key: magic.link → Dashboard → API Keys
MAGIC_PUBLISHABLE_KEY=
# Magic SECRET key (server-side only — for DID token verification via @magic-sdk/admin)
# NEVER expose this in frontend code
MAGIC_SECRET_KEY=

# Particle Network (Universal Accounts + EIP-7702)
# Get keys: dashboard.particle.network → create project + web app
PARTICLE_PROJECT_ID=
PARTICLE_CLIENT_KEY=
PARTICLE_APP_ID=

# Openfort (agent backend wallet + gas sponsorship) — $100 bounty
# Get keys: openfort.io → Dashboard
# Setup: create project → enable backend wallets (get WALLET_SECRET) →
#   create policy (Base 8453 + Arbitrum 42161, sponsorEvmTransaction) →
#   create feeSponsorship (pay_for_user, linked to policy) →
#   put all 3 IDs below. See docs/SUBMISSION.md §4.
OPENFORT_SECRET_KEY=
OPENFORT_WALLET_SECRET=
OPENFORT_FEE_SPONSORSHIP_ID=

# ZeroDev (Smart Routing Address + session keys) — OPTIONAL (stretch)
# Get key: dashboard.zerodev.app → Projects → your project ID
ZERODEV_PROJECT_ID=

# ── Database ────────────────────────────────────────────────────
# Local dev (docker-compose): postgresql://pouch:pouch@localhost:5432/pouch
# Production: use Supabase connection string
DATABASE_URL=postgresql://pouch:pouch@localhost:5432/pouch

# ── AI / LLM (agent intelligence layer) ─────────────────────────
# Provider for the conversational agent. Empty = regex-only (always works).
# The admin supplies their own API key + model.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash

# ── Security ────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=
WEBHOOK_SECRET=

# ── Frontend (apps/web) ─────────────────────────────────────────
# Client-exposed Magic publishable key (NEXT_PUBLIC_* is inlined into the browser bundle)
NEXT_PUBLIC_MAGIC_PUBLISHABLE_KEY=
# Used by apps/web/next.config.ts rewrites() — server-side only (no NEXT_PUBLIC_ prefix)
API_BASE_URL=http://localhost:3001
