{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "noEmit": true,
    "isolatedModules": true,
    "allowJs": true,
    "baseUrl": "../..",
    "paths": {
      "@pouch/shared": ["packages/shared/src/index.ts"],
      "@pouch/domain": ["packages/domain/src/index.ts"],
      "@pouch/infra-offramp": ["packages/infra-offramp/src/index.ts"],
      "@pouch/infra-web3": ["packages/infra-web3/src/index.ts"],
      "@pouch/infra-db": ["packages/infra-db/src/index.ts"],
      "@pouch/infra-ai": ["packages/infra-ai/src/index.ts"],
      "@pouch/api": ["apps/api/src/app.ts"],
      "@particle-network/universal-account-sdk": ["packages/infra-web3/node_modules/@particle-network/universal-account-sdk/dist/index.d.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
